# fill value & rename/copy this file to .env

# ---------------------- telegram bot token -----------------------
# obtained from @BotFather (with verified badge!)
BOT_TOKEN="12345678910:ABCDEFG"                # put your bot token

# ----------------------- database credential -----------------------
DB_URL="https://your-project.supabase.co"      # put your supabase url
DB_KEY="sb_secret_12345"                       # put your supabase key

# ------------------------- api endpoints -------------------------
ENDPOINT_1="https://api.example.com/api/"      # endpoint 1
ENDPOINT_2="https://api.example.com/api/"      # endpoint 2
ENDPOINT_3="https://api.example.com/api/"      # endpoint 3
# u can add or modify endpoints as needed ;)

# -------------------------- endpoint key -------------------------
KEY_1="YOUR_API_KEY"                    # put your endpoint apikey
KEY_2="YOUR_API_KEY"                    # put your endpoint apikey
# add more keys if you have multiple endpoints, just like the endpoints above

# --------------------------- ai setting --------------------------
AI_MODEL="your-ai-model"                       # put your preferred AI model
AI_PROMPT="./source/prompt/default.md"         # put your prompt file path
AI_KEY="YOUR_API_KEY"                          # put your ai apikey

# -------------------------- other settings ------------------------
BOT_CONN=polling                               # set to webhook or polling
OWNER_ID="12345678910"                         # put your telegram user id
CHANNEL_ID="12345678910"                       # put your telegram channel id

# uncomment if BOT_CONN="webhook"
# WEBHOOK_URL="https://your-domain.com/webhook"
# PORT="3000"
